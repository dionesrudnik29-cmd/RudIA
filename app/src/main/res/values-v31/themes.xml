<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RudIA" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rud_background</item>
        <item name="colorPrimary">@color/rud_violet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Abertura do sistema (Android 12+) com o mesmo fundo e ícone; depois entra a animação do app. -->
        <item name="android:windowSplashScreenBackground">@color/rud_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rud_background</item>
    </style>
</resources>
